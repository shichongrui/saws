{
  "name": "@saws/hono",
  "version": "0.0.0",
  "description": "Hono HTTP service and RPC client for SAWS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shichongrui/saws.git",
    "directory": "packages/hono"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@saws/core": "0.0.0",
    "@saws/docker": "0.0.0",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@saws/host": "0.0.0",
    "@saws/secrets": "0.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
